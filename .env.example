# Asya Bot (@asiaexp_bot) — Ася Автоэксперт

# Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner Telegram ID
OWNER_ID=265070804

# Channel
CHANNEL_ID=1479468835
CHANNEL_USERNAME=@sochiautoparts

# Pollinations AI — DUAL KEY FAILOVER (KEY1 → KEY2 → Free API)
POLLINATIONS_API_KEY=your_pollinations_api_key_here
POLLINATIONS_API_KEY_2=your_pollinations_api_key_2_here

# Pollinations FREE API (no auth required) — fallback when keys are depleted
POLLINATIONS_FREE_TEXT_URL=https://text.pollinations.ai
POLLINATIONS_FREE_IMAGE_URL=https://image.pollinations.ai

# Cloudflare Workers AI — Mistral Small 3.1 (2 accounts, 10K req/day each)
CF_ACCOUNT_ID_1=your_cf_account_id_1_here
CF_API_TOKEN_1=your_cf_api_token_1_here
CF_ACCOUNT_ID_2=your_cf_account_id_2_here
CF_API_TOKEN_2=your_cf_api_token_2_here

# HuggingFace — for image generation fallback
HF_TOKEN=your_huggingface_token

# GitHub PAT (for self-dispatch in Actions)
GH_PAT_TOKEN=your_github_pat_here
GH_REPO=sochiautoparts/asya-bot

# Database
DB_PATH=data/asya.db

# News settings
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200

# Image search providers (v4.0 — multi-provider pipeline)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Schedule: every 30 minutes, 2 posts per cycle + partner posts
NEWS_INTERVAL_MINUTES=30
CHANNEL_POST_INTERVAL_MINUTES=30
PARTNER_POST_INTERVAL_HOURS=4

# Log level
LOG_LEVEL=INFO
