# Asya Bot (@asiaexp_bot) — Ася Автоэксперт

# Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner Telegram ID
OWNER_ID=your_telegram_user_id

# Channel
CHANNEL_ID=@sochiautoparts
CHANNEL_USERNAME=sochiautoparts

# Pollinations AI
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# GitHub PAT (for self-dispatch in Actions)
GH_PAT_TOKEN=your_github_pat_here
GH_REPO=sochiautoparts/asya-bot

# Database
DB_PATH=data/asya.db

# News settings
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200

# Log level
LOG_LEVEL=INFO
